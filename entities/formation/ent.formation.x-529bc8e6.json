{
  "id": "ent.formation.x-529bc8e6",
  "type": "formation",
  "name": "朱雀阵",
  "aliases": [
    "朱雀奇阵",
    "青色光幕",
    "Zhuque Formation",
    "青幕"
  ],
  "summary": "朱雀星上最强大的阵法，可大可小，全开笼罩整个朱雀星，用于抵御域外修士与妖兽；本章笼罩整个朱雀大陆，且因融入巨魔族血液而具备巨魔族神通之术。",
  "attributes": {
    "品阶": "威能堪比一个问鼎后期",
    "效果": "笼罩整座大陆乃至整个朱雀星、缩小可护一人、幻化青光拳头反击来袭攻击、具备巨魔族天赋神通、笼罩朱雀大陆形成青幕、可整阵转移至单人护体，化青芒如虹卷起漩涡",
    "出处": "朱雀星/朱雀国",
    "破解法": "由化作阵眼之人开启缺口、遁天需动用第四魂",
    "布置者": "乾风操控"
  },

  "type": "beast",
  "name": "吉穷",
  "aliases": [
    "十八头凶兽",
    "深渊中升起的存在",
    "Ji Qiong",
    "十八头吉穷",
    "三十六头凶兽",
    "太古凶兽吉穷",
    "十七头妖兽吉穷",
    "天阶道兽吉穷",
    "道兽吉穷",

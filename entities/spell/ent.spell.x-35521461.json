  "name": "禁法之矛",
  "aliases": [
    "禁法长矛"
  ],
  "summary": "王林掐诀虚空一引施展的禁制类攻伐法术：漫天黑色禁气如游龙凝聚右手，成三丈长、手臂粗细的黑色长矛，矛身黑电缭绕、雷鸣不绝，掷出化作黑色闪电并引动九天之雷。",
  "attributes": {
    "类型": "禁制凝形攻伐法术",
    "威力": "破空如损天破地，引动九天之雷",
    "出处": "王林以上古禁制之道推演施展",
    "适用境界": "元婴期及以上（本片段王林所用）"
  },

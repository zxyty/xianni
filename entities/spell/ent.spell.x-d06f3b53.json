{
  "id": "ent.spell.x-d06f3b53",
  "type": "spell",
  "name": "撕天",
  "aliases": [
    "撕天之术",
    "Si Tian",
    "撕天术",
    "撕天之力",
    "撕夭之术",
    "双手撕天"
  ],
  "summary": "烨寞神通中极强之术，以万物为天、以古族双手撕开天地；可撕裂苍天、撕碎巨脚与古之三族虚影，直至撕开人身。",
  "attributes": {
    "类型": "攻击/破界神通、撕裂类杀伐神通、道古神通、神通、毁灭/撕裂类神通、撕裂类神通、空间撕裂神通、道古之力神通、空间撕裂类神通",
    "威力": "撕裂天地万物，无人可挡、险些撕杀王林、可撕开空玄初期修士心神致死，空玄中期遇之亦要避退、足以开天、空玄期仙人无抵抗资格，肉身与元神同灭、撕开虚无成巨大裂缝，可分裂摧毁星空漩涡、可撕开第三步修士的身体、撕裂冰池与大地，裂缝蔓延向深处、可令玄劫修士全力应对",
    "出处": "烨寞神通，由父祖传承于烨寞之子、烨寞之子、眉心八滴血液、道古传承、道古烨寞右手最强之力、烨寞之手、烨寞右臂之力、烨寞之臂、烨寞（道古）传承双臂、王林",
    "适用境界": "第三步级数强者"
  },

{
  "id": "ent.spell.x-9bf3a211",
  "type": "spell",
  "name": "黄泉指",
  "aliases": [
    "黄泉一指",
    "Huang Quan Zhi",
    "王林小指"
  ],
  "summary": "司徒南三式杀招的最后一式，以小指虚空点出；施展时全身生机尽消、无仙力波动。由司徒南于生死之际的黄泉中感悟、结合残次下品仙术模仿而成，威力接近真正的破碎下品仙术。",
  "attributes": {
    "类型": "指诀杀招／三式杀招第三式、指法神通",
    "威力": "不如真正的破碎下品仙术，但相差不远、问鼎中期需双手同接，若非奇遇必受伤",
    "出处": "司徒南于黄泉生死之际感悟，结合残次下品仙术模仿而出",
    "消耗": "施展时生机完全消散；境界不足会遭自身反噬",
    "适用境界": "婴变中期可勉强用出且不可用绝，婴变后期需谨慎，问鼎之后方可随心所欲"
  },

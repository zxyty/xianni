  "name": "符文神通",
  "aliases": [
    "灰气符文",
    "金色符文神通"
  ],
  "summary": "王林本章新创：以杀戮灰气为墨、食指为笔连画三笔，第三笔时脑中石像所得金色符文融入，爆发磅礴之力，可正面撞碎三十浪妖海并激射三道灰气穿透妖海。",
  "attributes": {
    "类型": "符文攻击神通",
    "出处": "第二个石像体内吸收的金色符文",
    "威力": "破妖海三十浪，余威激射三道灰气",
    "适用境界": "婴变后期大圆满"
  },

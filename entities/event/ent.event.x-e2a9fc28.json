{
  "id": "ent.event.x-e2a9fc28",
  "type": "event",
  "name": "望月怒发古神一指崩八角封印",
  "aliases": [
    "第835章月兽反击"
  ],
  "summary": "红袍老者八角封印锁死望月，炎雷子与黑袍男子清场送走四周修士；望月震怒睁目施出古神一指，一指崩碎封印，三人分别化炎龙、红色细剑、黑鹰虚影迎击。",
  "attributes": {
    "章节": "第835章",
    "地点": "罗天北域",
    "参与方": "望月、炎雷子、黑袍中年男子、红袍老者、姚家族人",
    "起因": "红袍老者以八角封印锁死望月，三人清场",
    "经过": "望月撞击封印无果后睁目幻化古神一指下按，封印崩溃；炎雷子化炎龙撞击，红袍老者化红色细剑刺出，黑袍男子化黑鹰虚影冲击",
    "结果": "八角封印崩碎，炎龙崩溃化火焰燃烧古神一指，胜负未定",
    "影响": "巨响彻响大半个罗天北域，各修真星修士皆感神念剧震"
  },

{
  "id": "ent.event.549",
  "type": "event",
  "name": "王林军营立威（第549章）",
  "aliases": [
    "立威",
    "斩孙统队",
    "军营屠兵事件"
  ],
  "summary": "王林沉默半月后借孙姓统队辱骂之机援引军规斩之，并屠其麾下过半妖兵、吸收妖力，引来九统队九千妖兵结阵围困与司马炎问罪，王林反以军规倒计时逼退。",
  "attributes": {
    "章节": "第549章",
    "地点": "天妖郡军营",
    "参与方": "王林、十三、虎咆、孙姓统队、司马炎、九个统队、九千妖兵",
    "起因": "孙姓统队操练路过王林打坐处，吐唾沫当众辱骂「废物」",
    "经过": "隔空擒拿→诵军规第八条→捏碎颈部毁修为吸妖气→仙剑弯刀屠戮千人方队过半→吸收数百妖兵妖力→九千妖兵结阵围困→王林援引军规第十三条与第二条并令十三计时",
    "结果": "孙姓统队及其半数以上妖兵身死，九统队中三人退后，倒计时进行中悬而未决",
    "影响": "军营上下对王林由轻蔑转为忌惮恐惧，司马炎「等其先动手」的策略被反制"
  },

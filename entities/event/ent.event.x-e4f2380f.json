{
  "id": "ent.event.x-e4f2380f",
  "type": "event",
  "name": "王林因果道境破姚长东荣耀道境",
  "aliases": [
    "823章道念之战",
    "因果道境之战"
  ],
  "summary": "王林在生死危机下施展因果意境，与姚长东的荣耀道境展开道念之战，以「仙人不修道故仙界崩溃」之论击碎其仙人虚影与道念。",
  "attributes": {
    "章节": "第823章",
    "地点": "罗天星域星空",
    "参与方": "王林、姚长东",
    "起因": "姚家追杀王林，姚长东欲趁其未达窥涅时将其击杀",
    "经过": "王林以因果之圈困敌；姚长东凝出仙人虚影相抗；王林以仙界崩溃、仙帝疯癫而亡为例破其荣耀道念",
    "结果": "姚长东两度喷血、心神重创，仙人虚影彻底崩溃；王林眉心半片纸符崩溃",
    "影响": "王林重伤，并立誓姚家要付出代价"
  },

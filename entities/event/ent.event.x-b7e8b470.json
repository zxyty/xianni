{
  "id": "ent.event.x-b7e8b470",
  "type": "event",
  "name": "神念远探贪狼一行",
  "aliases": [
    "十里外窥探六人",
    "贪狼喝问"
  ],
  "summary": "周佚携王林神识穿越紫雾直抵十里外空旷处，窥见贪狼与五名大罗剑宗弟子；贪狼睁眼喝问后二人退回，王林由辰龙喜色推断出求救信号。",
  "attributes": {
    "地点": "紫雾内空旷处",
    "参与方": "王林、周佚、贪狼、辰龙、大罗剑宗",
    "起因": "周佚剑识察觉前方十里有六人，装束眼熟",
    "经过": "周佚神念融体携王林神识离体远探，被贪狼喝破后迅速退回雾中",
    "结果": "王林判定大罗剑宗五弟子与贪狼非同队，辰龙喜色实为求救；贪狼因摸不清对方底细未出手",
    "影响": "周佚对王林评价发生根本转变，视其心机睿智极为可怕"
  },

{
  "id": "ent.event.x-be81896b",
  "type": "event",
  "name": "李倩梅十年血祭王林石像",
  "aliases": [
    "十年以血抹身",
    "李倩梅守石像十年"
  ],
  "summary": "李倩梅在蛮荒大陆山谷以鲜血、精血、元神道血连续十年涂抹王林所化石像，逐年加码透支生命，至第十年第九个月睁眼凝望雕像。",
  "attributes": {
    "章节": "第1285、1286章",
    "时长": "十年（本片段至第十年第九个月）",
    "地点": "云海二阶星域·蛮荒大陆·山谷",
    "参与方": "李倩梅、王林（石像）",
    "起因": "苍老之声称此法坚持十年王林有苏醒可能",
    "经过": "前六年每日休息不足两时辰；第七年降至半时辰、丹药耗尽；第八年无休；第九年动用舌尖与心头精血；第十年动用元神道血",
    "结果": "石像由沧桑老者化作青年；第十年第九个月李倩梅睁眼久望雕像",
    "影响": "指向王林苏醒"
  },

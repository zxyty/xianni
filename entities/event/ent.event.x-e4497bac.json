{
  "id": "ent.event.x-e4497bac",
  "type": "event",
  "name": "无极宗大比·王林战白发老者",
  "aliases": [
    "残夜破网",
    "流月逆岁"
  ],
  "summary": "无极宗白发老者以规则之网试探威逼王林，王林以残夜破网并反问「你可敢接我一式神通」，继以流月逆转其五千年岁月，老者喷血挣脱、骇然退避。",
  "attributes": {
    "章节": "第1258-1259章（第九卷 云海之巅）",
    "地点": "无极宗大比平台",
    "参与方": "王林、无极宗白发老者、近十万围观修士、无极宗诸长老",
    "起因": "无极宗欲收服王林，遣白发老者出手试探、威逼、教训",
    "经过": "规则之网罩落 → 残夜破网 → 老者血之规则全力冲击、大比平台瓦解 → 流月之门显化 → 流月逆转五千年",
    "结果": "老者喷血挣脱流月，散出的血点回体，骇然退避；王林元力所剩不多，未能留人",
    "影响": "王林在无极宗立威，老者对其生出高深莫测之感，教训试探之意尽消"
  },

  "type": "event",
  "name": "王林与天道使者夺元婴之战",
  "aliases": [
    "逆天夺元婴",
    "红云巨掌之战"
  ],
  "summary": "王林以生死轮回轴包裹李慕婉元婴，与红云凝成的天道使者巨掌数度硬撼，本尊破土助战化古神巨人，王林同时锁定万里外山村。",
  "attributes": {
    "章节": "第338—339章",
    "地点": "楚国上空",
    "参与方": "王林、本尊、天道轮回使者",
    "起因": "王林拒绝让李慕婉元婴随轮回消散，宣告「天让你死，我也把你抢回来」",
    "经过": "画轴裹元婴—巨掌三度抓来—禁幡化长枪碎裂—本尊化巨人硬撼被砸入地下三千里再战—王林一指点掌心喷血，血落画轴使元婴生机复起",
    "结果": "元婴暂得保全，王林锁定万里外山村",
    "影响": "引出第339章「转世重生」"
  },

{
  "id": "ent.event.x-a5ddf18f",
  "type": "event",
  "name": "王林拒绝让王平修道",
  "aliases": [
    "一生不要修道",
    "孙泰劝修道被拒"
  ],
  "summary": "孙泰以王平天资极好、王林修为可助其修道为由劝说，王林两度决绝拒绝，只愿王平平安做凡人。",
  "attributes": {
    "章节": "第689章",
    "地点": "落月村王林家院中",
    "参与方": "王林、孙泰",
    "起因": "孙泰询问王林打算陪孩子多久，王林答「一世轮回」",
    "结果": "王林宣告「我不会让他修道，永远」，此后修道之事莫要再提",
    "影响": "确立王林对修真之路的否定态度与对凡俗平安的寄托"
  },

{
  "id": "ent.event.x-59fccc84",
  "type": "event",
  "name": "王林河道听琴悟道",
  "aliases": [
    "三日闻琴",
    "强颜欢笑之琴"
  ],
  "summary": "王林连续三日于洪城河道旁独酌听明萱琴音，忘却拓森之危与问鼎之期待，悟出「以心中之感动逆天而行」的逆道之论。",
  "attributes": {
    "章节": "第571章",
    "地点": "洪城河道",
    "参与方": "王林、明萱",
    "起因": "等待莫厉海安排入洪牢事宜的三日空档",
    "经过": "夜饮古妖城美酒独坐莫府院中，此后每日清晨赴河道听画舫短暂琴音",
    "结果": "完成一场「心的洗礼」；明萱被迫改弹欢快曲调，实为强颜欢笑",
    "影响": "确立王林「非顺天，而以心中感动逆天而修」的道心，为后续杀戮明悟埋下伏笔"
  },

  "name": "碎片崩溃中王林截杀红蝶",
  "aliases": [
    "第294章截杀红蝶",
    "禁气长枪战白玉镯"
  ],
  "summary": "王林趁红蝶重伤跌境、四面裂缝无路可退之际发起必杀，以禁气长枪与岁月意境连番进逼，红蝶以白玉镯硬挡、喷血后退并诵咒破去岁月意境。",
  "attributes": {
    "章节": "第294章",
    "地点": "崩溃的碎片空间",
    "参与方": "王林、红蝶、叱虎",
    "起因": "红蝶几次三番对王林动杀机，王林认定日后必是麻烦，趁其最低谷下杀手",
    "经过": "禁幡凝禁气长枪→击碎白色飞剑→白玉镯挡枪使其溃散→九木雕降岁月意境锁命→红蝶诵咒催镯放光破意境",
    "结果": "红蝶喷血重伤后退但未死，岁月意境被破，王林手指刺痛",
    "影响": "白玉镯来历指向仙剑级别，成为后续伏笔"
  },

{
  "id": "ent.event.x-59c0ecfb",
  "type": "event",
  "name": "封仙天之关一息入定",
  "aliases": [
    "一息入定",
    "第813章天之关"
  ],
  "summary": "王林（化名许木）在封仙第三关面对战之一字画轴，一息入定、十息后第三目红光爆发包裹画轴，窥见战字来历幻象，震动全场。",
  "attributes": {
    "章节": "第813章",
    "地点": "封仙第三关（天之关）",
    "参与方": "王林、烈云子、血神子、清水、炎雷子、向家老祖、战空烈、许霆",
    "起因": "王林抬头直视战之一字画轴，被其本源之力摄取心神",
    "经过": "一息入定→心神一分为二融入战字→一丝本源之力入体冲入眉心第三目→十息后红光扇形喷出包裹画轴→于画轴中见白衣老者写战字化六轴之幻象",
    "结果": "第三目化作一条红线永固于眉心；烈云子许诺封仙结束后给他看剩下的两幅战图",
    "影响": "全场老祖由轻视转为重视；血神子再起杀意被清水压制；许霆彻底被盖过"
  },

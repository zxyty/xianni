{
  "id": "ent.event.x-57f3680c",
  "type": "event",
  "name": "天运宗阴虚失踪禁忌",
  "aliases": [
    "达阴虚者一年内失踪",
    "天运宗禁忌",
    "同门离奇失踪之谜"
  ],
  "summary": "天运宗内凡修为突破问鼎圆满达到阴虚者，不出一年必离奇失踪；隐匿修为者一旦解封亦难逃，传闻皆被天运子活活吞噬。",
  "attributes": {
    "章节": "第961章（由赵欣梦向王林揭露）",
    "地点": "天运宗（天运星）",
    "参与方": "天运子、天运宗嫡传七系弟子、赵欣梦、孙虹、卢海、橙系一子",
    "起因": "弟子修为突破问鼎圆满达到阴虚，或已隐匿修为者的封印被打开",
    "结果": "当事人一年内离奇失踪；宗内传闻其被师尊吞噬",
    "影响": "众弟子普遍自我封印修为求存，此事成为宗内绝对禁忌"
  },

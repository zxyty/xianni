  ],
  "summary": "木冰眉在云海神宗庭院向王林告知拓森之乱，王林点破其眉心古神烙印并将之吞噬融入第六星，进而推断拓森已去界外。",
  "attributes": {
    "章节": "第1264章",
    "地点": "云海神宗庭院",
    "参与方": "王林、木冰眉",
    "起因": "木冰眉逃至云海欲恢复修为，偶遇王林并欲示警",
    "结果": "烙印被吞噬，第六星更稳固；王林断定拓森已破封界大阵去界外",
    "影响": "拓森借烙印感应到王林在界内，却已无力短期再破封界"
  },

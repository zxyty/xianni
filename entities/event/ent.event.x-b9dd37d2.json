  ],
  "summary": "王林在生死危机中接连爆发死气、古神碎星、崩溃规则之星，感悟出生与死、因与果、真与假三道本源，为天地间前所未有；水道子惊骇欲绝，倾全力以修真星轰下。",
  "attributes": {
    "章节": "第1280章",
    "参与方": "王林、水道子",
    "起因": "王林濒死，欲与水道子同归于尽而自毁星点与规则之星",
    "经过": "死气漩涡生第一道本源；古神碎星生第二道本源；规则之星崩溃生第三道本源",
    "结果": "王林得三道本源（尚弱小未大成）；水道子杀心更坚，爆发第三步全力以修真星砸落",
    "影响": "王林被水道子疑为大能转世乃至第四步踏天之道转世，第三步之境向其打开门缝"
  },

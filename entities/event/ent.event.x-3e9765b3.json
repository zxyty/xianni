{
  "id": "ent.event.x-3e9765b3",
  "type": "event",
  "name": "王林刺激望月苏醒并擒杀姚云海",
  "aliases": [
    "第831章望月之变",
    "望月体内伏杀"
  ],
  "summary": "王林潜入望月体内直奔望月骨敏感之位以加速其苏醒；追兵大量沉入体内引发震动，小型望月破土吞人，王林趁乱偷袭姚云海，崩其肉身、擒其元神后借力遁走。",
  "attributes": {
    "章节": "第831章",
    "地点": "望月所化星球体内（罗天北域）",
    "参与方": "王林、姚云海、姚冰云、姚家族人及众多修真家族修士、望月、小型望月",
    "起因": "王林被姚家与众多修真家族追杀，欲借望月之威反制并夺取贪狼大鼎",
    "经过": "潜入体内→见半截望月骨重聚→决意刺激敏感之位→追兵沉入引发震动→小型望月破土吞人→王林自泥土钻出点姚云海后心",
    "结果": "姚云海肉身被崩碎、元神被昆极鞭击中并被王林抓住；王林借血肉与元力波动阻挡望月后遁走",
    "影响": "望月已现苏醒迹象，苏醒后将是一场浩劫"
  },

{
  "id": "ent.event.x-72cdb080",
  "type": "event",
  "name": "贪狼见王林弃宝遁逃",
  "aliases": [
    "贪狼逃遁"
  ],
  "summary": "贪狼摆出九石碑、九十九长剑、万丈树人、天皇炉、黑雾长枪欲当众轰杀“钟大洪之主”，看清来人是王林后凄厉尖叫、速度暴增九十余倍，连法宝都来不及收便逃遁。",
  "attributes": {
    "章节": "第1297章",
    "地点": "暗蝎族修真星",
    "参与方": "贪狼、王林、云遁族、钟大洪",
    "起因": "钟大洪称其主必杀贪狼，贪狼欲当众杀其主立威",
    "经过": "贪狼连出多件法宝夸耀，王林自天空波纹中现身",
    "结果": "贪狼弃宝逃遁，众修士与钟大洪皆愣住，王林亦怔然唤出“贪狼”"
  },

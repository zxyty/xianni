{
  "id": "ent.event.x-25818e86",
  "type": "event",
  "name": "王林蝎庙度玄劫",
  "aliases": [
    "第1903章王林度玄劫",
    "雪劫与九飓风劫"
  ],
  "summary": "王林于绿魔洲蝎形庙宇蝎尾之上主动引来玄劫，威压笼罩数千里，连续破去第一劫雪劫与第二劫九道飓风，两度评「太弱」。",
  "attributes": {
    "章节": "第1903章",
    "地点": "蝎子庙宇（蝎尾）",
    "参与方": "王林、五行真身、绿魔洲修士",
    "起因": "王林修为达空玄圆满巅峰，主动引劫求空劫蜕变",
    "经过": "释放威压覆盖数千里；雪劫化雪刃被五行真身九十九条炎龙、万丈火龙焚碎；九道飓风逐一裹身合为大风暴，王林饮酒不动",
    "结果": "第一劫崩溃，第二劫承受完毕，王林评『太弱』『还是太弱』",
    "影响": "远处绿魔洲修士误以为是绿魔大人复活后重历玄劫"
  },

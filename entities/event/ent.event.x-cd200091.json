{
  "id": "ent.event.x-cd200091",
  "type": "event",
  "name": "血龙守漩涡之战",
  "aliases": [
    "炎雷子与尸阴宗八王围攻血龙",
    "第1133章血龙之战"
  ],
  "summary": "炎雷子与尸阴宗八王联手强攻守在血色世界漩涡外的血龙，血龙以五轮递增的黑夜之力反制，最终身受贯穿千丈之伤，露出古神心血。",
  "attributes": {
    "章节": "第1133章",
    "地点": "血色世界漩涡入口外的虚无",
    "参与方": "血龙、炎雷子、尸阴宗八王、王林（旁观后出手）、黑衣老人（未出手）",
    "起因": "拓森令血龙打开通向血色世界的漩涡，血龙如凶兽般盘守其外",
    "经过": "九名大神通修士强攻，血龙分裂八对瞳孔施展一至五息递增的黑夜之力，崩碎雷仙界碎片与尸阴两阵",
    "结果": "血龙头部受贯穿千丈之伤，伤口内现古神心血；尸阴八王喷血、炎雷子带伤退后",
    "影响": "王林发现古神心血并冲出抢夺，不惜炸碎左臂"
  },

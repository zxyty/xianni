{
  "id": "ent.event.x-56cf280e",
  "type": "event",
  "name": "王林凝聚火本源真身",
  "aliases": [
    "本源真身，凝",
    "第1815章凝真身"
  ],
  "summary": "王林于天牛洲杜青护法处凝聚火本源真身，抽百七十二条支脉魂与两条子脉龙魂，凝出朱雀真身四肢。",
  "attributes": {
    "章节": "第1815章",
    "地点": "天牛洲·杜青护法之处",
    "参与方": "王林、杜青",
    "起因": "吸收十六条支脉、吞噬一条子脉地火魂并得『火的意志』，火本源始有自我意志",
    "经过": "掐诀数个时辰凝出双腿→神识按地抽一百七十二条支脉龙魂→双翅化双手→再抽东西两条子脉龙魂，令杜青牵制其一",
    "结果": "真身四肢凝成，尚差身躯与头颅",
    "影响": "杜青首睹本源真身凝聚，为其日后修炼轰开道路"
  },

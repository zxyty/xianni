{
  "id": "ent.event.x-0deac7dd",
  "type": "event",
  "name": "王林鼓音传念传道",
  "aliases": [
    "第十一声鼓鸣"
  ],
  "summary": "第十一响以悲入神、以念敲鼓，悲伤之念随鼓音波及天妖城，全场沉浸共鸣、泪流满面；金甲男子色变，玄副帅修为松动，天帅第一次起身发问。",
  "attributes": {
    "章节": "第591-592章",
    "地点": "万丈广场",
    "参与方": "王林、天帅、玄副帅、金甲男子、墨非、莫厉海、石萧",
    "起因": "王林明悟自身之道，以李慕婉离去后的悲伤与画舫琴音之感悟入鼓",
    "结果": "鼓声含念、传道天地；除妖帅与极个别人外全场泪流满面；墨非无共鸣",
    "影响": "天帅第一次彻底睁眼站起，问「他，叫做王林么」；玄副帅疑其为妖帝等待无数年之人"
  },

{
  "id": "ent.event.x-c26bbfb1",
  "type": "event",
  "name": "四黑衣人围杀王林",
  "aliases": [
    "店铺前围杀",
    "第267章杀人"
  ],
  "summary": "四名元婴后期黑衣人奉「清除国境200年可疑者」之命围杀王林，以四色剑网困之；王林以岁月意境滞其剑气、化虚穿网现身其中一人身后，杀星复出。",
  "attributes": {
    "章节": "第267章",
    "地点": "王林所在店铺外",
    "参与方": "四黑衣人、王林、周武泰",
    "起因": "四派联盟下令除掉本国国境200年来一切可疑者",
    "经过": "周武泰拒绝出手并旁观；四人化黑烟掐诀，青红蓝紫四道剑光织成剑网围困；王林虚空一点散出岁月意境使剑气一滞，身形化虚穿网",
    "结果": "王林现身于一名黑衣人身后，「出鞘既杀人」",
    "影响": "王林打破三十多年不杀一人的化凡收敛，杀星重现"
  },

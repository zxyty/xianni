{
  "id": "ent.event.x-63071f30",
  "type": "event",
  "name": "绿魔洲—孟土洲边界围杀战",
  "aliases": [
    "第1889章边界之战",
    "道魔宗围杀王林"
  ],
  "summary": "道魔宗以六（七）座大范围传送阵连投四波数百人围杀王林，王林尽出神通全歼追兵后重伤逃入孟土洲，章末宗主亲至。",
  "attributes": {
    "章节": "第1889章",
    "地点": "绿魔洲与孟土洲边界",
    "参与方": "王林、道魔宗",
    "起因": "道魔宗倾宗之力欲杀王林（与私仇有关但不止于私仇）",
    "经过": "残夜灭第一二波；神妖魔＋古道无仙灭第三波；役灵印等五神通灭第四波并毁三阵；虚火＋血剑＋鬼帆横冲百里",
    "结果": "边界道魔宗修士几近全灭，王林魂铠耗尽、道古之力枯竭，重伤踏入孟土洲",
    "影响": "道魔宗主亲自现身；宗内评估代价或致九宗十三门变八宗十三门"
  },

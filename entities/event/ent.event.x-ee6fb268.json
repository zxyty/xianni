{
  "id": "ent.event.x-ee6fb268",
  "type": "event",
  "name": "蚊兽救周茹于巨大蚯蚓",
  "aliases": [
    "第409章蚊兽杀蚯蚓"
  ],
  "summary": "周茹故意不避地底钻出的十多丈长巨大蚯蚓，引来蚊兽将其拽出地面并吸干血肉精华，随后飞走，周茹与小白追踪未果。",
  "attributes": {
    "章节": "第409章",
    "世内时序": "周茹苏醒一年后",
    "地点": "月星山脉",
    "参与方": "周茹、小白、蚊兽、巨大蚯蚓",
    "起因": "周茹欲借遇险引出蚊兽以追踪王林下落",
    "经过": "蚊兽自天而降，口器刺穿蚯蚓并将其整条拽出，自头部刺入吸尽血肉精华",
    "结果": "蚯蚓被吸干而死，蚊兽飞走，小白速度不及追踪失败",
    "影响": "周茹的追踪线索再度中断，但确信遇险必有蚊兽赶来"
  },

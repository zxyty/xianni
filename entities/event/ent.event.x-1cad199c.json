{
  "id": "ent.event.x-1cad199c",
  "type": "event",
  "name": "古道山求见古道大天尊",
  "aliases": [
    "古道山顶铃声彻",
    "塔外三日等待"
  ],
  "summary": "玄罗在未获召见的情况下私自带王林登古道山求见古道大天尊，塔中少年传话「古主正在神游」，师徒二人在铃声压制下恭立等待三日仍未获召见。",
  "attributes": {
    "章节": "第2011章",
    "地点": "古道山、古道山九层高塔",
    "参与方": "王林、玄罗、塔中灰袍少年、古道大天尊",
    "起因": "玄罗欲让古道大天尊确认王林身份，使其可不受屈辱地守护道古一脉",
    "经过": "步行登通天石阶；塔前抱拳求见；少年传话神游；恭立三日，铃声持续压制王林修为与本源",
    "结果": "截至本章末尚未获得召见，悬念未决",
    "影响": "若召见则王林在道吉一族地位超然、烨道不敢多言；若不召见玄罗将承担私自带人之风险"
  },

  "type": "event",
  "name": "王林破魂魔舟前两层禁制",
  "aliases": [
    "五个时辰破甲板禁制",
    "帆布鬼脸之变"
  ],
  "summary": "王林五个时辰明悟古魂禁并反向操控魂魔舟甲板数千万禁制，随后再用七个时辰攻破第二层，令矾珊梦的操控之力接连被夺。",
  "attributes": {
    "章节": "第1697章",
    "地点": "魂魔舟甲板",
    "时长": "约一整天（甲板五个时辰＋第二层七个时辰）",
    "参与方": "王林、矾珊梦、七彩道人",
    "起因": "矾珊梦允诺若王林破开禁制便赠舟；船外七彩道人正在破外围光幕",
    "经过": "帆布鬼脸窥视→静心推衍→破第一个古魂禁符文→连溃数万→以破灭禁生死禁岁月禁横扫→操控大半甲板禁制→转入第二层",
    "结果": "第一、二层禁制被王林操控，矾珊梦对此舟操控仅比王林多一丝",
    "影响": "矾珊梦面色苍白、眼露寒光，赠舟之诺悬而未答"
  },

{
  "id": "ent.event.x-77d61aa9",
  "type": "event",
  "name": "白凡等人开创四大仙界",
  "aliases": [
    "四大仙界之立",
    "另开天地"
  ],
  "summary": "白凡与几位同为仙域之人另开天地，把当年通向仙域的四大通道自成地域，称之为仙界，即风雨雷电四大仙界，将天地星空化成四份。",
  "attributes": {
    "章节": "第945章（清水追述）",
    "世内时序": "远古仙域消失之后",
    "参与方": "白凡、几位曾为仙域之人",
    "起因": "远古仙域消失",
    "结果": "风雨雷电四大仙界成立，天地星空化为四份",
    "影响": "雨界下昆虚后更名为联盟"
  },

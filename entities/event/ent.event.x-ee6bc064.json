{
  "id": "ent.event.x-ee6bc064",
  "type": "event",
  "name": "王林逼退久帝并重创道一",
  "aliases": [
    "黑白之阳撞白狼",
    "踏道一索头骨"
  ],
  "summary": "王林以大天尊之阳轮廓一脚击溃久帝白狼，穿透道一弯刀一指点其眉心，将其踏于地面，索得婴儿头骨后放其离去。",
  "attributes": {
    "章节": "第1998章",
    "地点": "仙族禁宫",
    "参与方": "王林、久帝、道一、海子",
    "起因": "道一先对王林出手，久帝出手拦阻不许杀道一",
    "经过": "黑白之阳对撞白狼→白狼崩溃久帝退→道一黑色弯刀斩九十九虚影→王林一指点眉心→海子蓝色波纹阻滞→王林黑丝穿透踏住道一",
    "结果": "道一交出婴儿头骨后破空遁走，王林收走头骨",
    "影响": "久帝记下此事，要求王林尽快成为大天尊并日后给交代"
  },

{
  "id": "ent.event.x-0cc9672a",
  "type": "event",
  "name": "人方之炼第一关（心魔关）",
  "aliases": [
    "人方试炼",
    "人方之关",
    "点燃人方之香"
  ],
  "summary": "王林以魂进入人方幻界的试炼，考的是心魔而非问道；目标为点燃人方之香，王林悟出点燃之法却先去探望故人。",
  "attributes": {
    "章节": "第1406章",
    "地点": "人方之幻界（貌如赵国、朱雀星）／大帝星巨龟背",
    "参与方": "王林、老朱雀、司墨子、云落大司、蓝梦道尊",
    "起因": "王林以魂入人方试炼，需点燃人方之香",
    "经过": "幻界遇与自己一模一样的虚魂青年，点破其身世后离去；悟出此关为心魔",
    "结果": "王林未即刻点香，欲先看故人一眼，本体在香下流下两行泪",
    "影响": "老朱雀焦急、司墨子冷笑第一少帝将丢颜面"
  },

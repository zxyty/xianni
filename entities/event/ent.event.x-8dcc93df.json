{
  "id": "ent.event.x-8dcc93df",
  "type": "event",
  "name": "拔山重塑洞府",
  "aliases": [
    "拔山",
    "第334章拔山"
  ],
  "summary": "王林于修魔海旧址以化神法力拔地起山、隔空成府，重现当年洞府，震动方圆数万里修士，并冲淡李慕婉身上的死气。",
  "attributes": {
    "章节": "第334章",
    "地点": "修魔海外围、南斗城附近旧洞府所在地",
    "参与方": "王林、李慕婉、铁岩、吕非",
    "起因": "旧洞府所在山脉消失，李慕婉黯然「物是人非」，死气骤浓",
    "经过": "王林右手一挥引动地裂鼓包，山峰破土而出；再双指隔空一点，于山峰中段成形洞府",
    "结果": "洞府与当年毫无区别，李慕婉展颜，死气冲淡；千里外修士惊骇围观",
    "影响": "李慕婉放弃火焚国之行，改为买下丹方即回家"
  },

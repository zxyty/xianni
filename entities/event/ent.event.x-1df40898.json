  "name": "王林神识横扫大王朝屠尸阴宗",
  "aliases": [
    "风扫残叶·大王朝清理"
  ],
  "summary": "王林自金城起，以窥涅神识扫过五大副城及大王朝所有城池，尽杀潜伏搜集怨气的尸阴宗弟子。",
  "attributes": {
    "章节": "第897章",
    "地点": "大王朝（都城、金木水火土五大副城及外围城池）",
    "参与方": "王林、尸阴宗",
    "起因": "尸阴宗遍设怨灵祭坛搜集怨气，并以王家后人饲养怨灵",
    "经过": "神识锁定城池，冷哼之下潜伏者肉身崩溃、元神瓦解",
    "结果": "大王朝境内尸阴宗弟子尽灭，元神化灵力融入大地滋养朱雀",
    "影响": "百姓惊慌不知所以；王林转向赵国总部"
  },

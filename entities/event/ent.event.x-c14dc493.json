{
  "id": "ent.event.x-c14dc493",
  "type": "event",
  "name": "王林悟成翻天印",
  "aliases": [
    "四月悟翻天印",
    "雨夜翻天"
  ],
  "summary": "王林盘膝四个月血泪推衍，于雷雨黑夜睁眼，瞳中天地转动，一喝「翻天」令所在修真星天地倒转。",
  "attributes": {
    "章节": "第1320章",
    "时长": "四个月",
    "参与方": "王林",
    "起因": "蓝梦道尊传下三式神通",
    "经过": "推衍至双目流血泪，雨夜瞳内天地翻转，右手按天喝「翻天」",
    "结果": "悟成翻天印并领悟「人身亦天地、逆转杀伤更强」，转而推衍光影盾",
    "影响": "蓝梦道尊在蓝山惊叹五道本源之人四月即成，远快于预估数年"
  },

{
  "id": "ent.event.x-e3d5637f",
  "type": "event",
  "name": "极天草原雨夜围杀王林",
  "aliases": [
    "雨杀",
    "四方合围王林"
  ],
  "summary": "绿魔洲近百修士分四路、由虚幻罗盘遥遥指引，在雨夜合围王林；王林反手连杀十二人并直扑许德才。",
  "attributes": {
    "章节": "第1861-1862章",
    "地点": "极天草原",
    "参与方": "王林、许德才、张姓老者、赵姓老者、持虚幻罗盘的空劫初期女修",
    "起因": "吕文冉怀疑王林，指派其巡逻以引出绿魔洲修士；绿魔洲猜到刘之源死于王林之手",
    "经过": "禁制罗盘示警→王林退避改向被同步锁定→踏地无法返地宫→血剑连杀十人→许德才放骷髅花信号→血龙再杀二人",
    "结果": "王林连杀十二人，直奔许德才",
    "影响": "两名空劫中期老怪与一名空劫初期修士全速赶来，半个时辰内可至"
  },

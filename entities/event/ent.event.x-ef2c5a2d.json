{
  "id": "ent.event.x-ef2c5a2d",
  "type": "event",
  "name": "王林斩杀刘之源",
  "aliases": [
    "极天草原空劫战死事件",
    "刘之源之死"
  ],
  "summary": "王林趁刘之源仙力枯竭退后服丹之机，以断空禁阵遮蔽神识、借天牛雾气阵法配合，数百丈外一拳轰碎其肉身与元神并收走头颅。",
  "attributes": {
    "章节": "第1859章、第1862章（追述，事发两天前）",
    "地点": "极天草原",
    "参与方": "王林、刘之源",
    "起因": "王林承青牛老祖之托斩杀绿魔洲空劫修士；刘之源仙力枯竭退后服丹露出破绽",
    "经过": "王林收缩断空禁阵遮蔽神识，以魂引归之术召罗云海，数百丈外一拳轰杀",
    "结果": "刘之源肉身崩碎、元神碎裂，头颅被王林收走；王林受伤面色苍白、刘之源死，绿魔洲空劫修士由六人减员",
    "影响": "绿魔洲全线撤退；两洲皆震动，绿魔洲循线锁定王林、绿魔洲锁定王林并展开四方围杀"
  },

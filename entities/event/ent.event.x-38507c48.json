{
  "id": "ent.event.x-38507c48",
  "type": "event",
  "name": "王林李广弓射灭掌尊之战",
  "aliases": [
    "第1691章围杀之战",
    "四强围杀王林"
  ],
  "summary": "王林以重伤诱敌引出掌尊、第七妃、妙音仙尊、九天魔尊，随后取李广弓射出第三箭，灭掌尊肉身、擒二尊元神、重伤第七妃。",
  "attributes": {
    "章节": "第1691章",
    "地点": "太古星辰内被掌尊封死的星域",
    "参与方": "王林、掌尊、第七妃、妙音仙尊、九天魔尊",
    "起因": "王林欲毁界外远古仙域、搅乱洞府界势力平衡，故意示弱引四人齐现",
    "经过": "役灵印、七彩长枪连败；六大本源剑加撕天之术破掌印；取李广弓闭目以神识拉弓射第三箭",
    "结果": "掌尊肉身崩溃后重聚逃遁；妙音仙尊、九天魔尊肉身爆开元神被收；第七妃重伤幸存",
    "影响": "掌尊道心受创、再不敢推算王林弓数；章末七彩之芒滔天而起，有人随光而来"
  },

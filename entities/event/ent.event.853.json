{
  "id": "ent.event.853",
  "type": "event",
  "name": "第853章血燕之战",
  "aliases": [
    "王林渡劫遭血神子截杀",
    "血燕之战"
  ],
  "summary": "天劫劫云笼罩万丈星空之际，血神子借姚云现身索要王林从望月体内所取之物，以言出法随与血燕强攻，撕裂星空断其退路并引红色天雷；王林接连祭出仙界山石魂爆、封仙印、第三辆射神车化五彩蝴蝶勉力周旋，最终以「古妖贝罗」之名迫使血神子骤然停手。",
  "attributes": {
    "章节": "第853章",
    "地点": "罗天南域星空（王林渡劫处）",
    "参与方": "王林、血神子、姚云",
    "起因": "血神子索要王林从望月体内取出之物",
    "经过": "言出法随震伤王林→血燕吞噬并反施山石魂爆→封仙印被破→射神车化五彩蝴蝶缠住血燕→血神子撕裂星空断退路、引红色天雷、欺身一抓",
    "结果": "王林喝出「古妖贝罗」，血神子身形一顿，眉心钻出青色双角妖物追问「贝罗在哪」",
    "影响": "揭示血神子体内寄有古妖、且身负古神幼子碎星之击未愈之伤"
  },

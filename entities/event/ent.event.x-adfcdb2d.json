{
  "id": "ent.event.x-adfcdb2d",
  "type": "event",
  "name": "河畔撒网明悟",
  "aliases": [
    "我为鱼道为网",
    "谢姓老者悟道"
  ],
  "summary": "谢姓老者于城北河畔见蓑衣渔翁撒网捞鱼，震悟「我为鱼，道为网，河为天，捞网者为造化」，王林随之凝风现身、点灵气入其体，赠其一场造化。",
  "attributes": {
    "章节": "第846章",
    "地点": "城北河畔",
    "参与方": "谢姓老者、蓑衣渔翁、王林",
    "起因": "谢姓老者被王林问道后心神难安，雨中徘徊至河畔",
    "经过": "渔翁捞网，网中大鱼绝望挣扎，老者如遭闪电击中",
    "结果": "老者悟出鱼网河造化之喻，王林亦得明悟并赐其一道天地灵气",
    "影响": "王林借凡人一悟推进自身求道"
  },

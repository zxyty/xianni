  "name": "王平",
  "aliases": [
    "犬子",
    "王林之子",
    "王林之子王平",
    "平儿",
    "王平儿",
    "Wang Ping",
    "黑雾中的怨婴",
    "雾内的怨婴",
    "被禁制封印的孩子",
